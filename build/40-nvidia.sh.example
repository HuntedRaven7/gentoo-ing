#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# NVIDIA is ALREADY installed by 10-build.sh
###############################################################################
# x11-drivers/nvidia-drivers ships with the base image: it is added to the
# PACKAGES list in 10-build.sh and consumed as a prebuilt binpkg from the
# gentoo-ing-akmods module overlay (priority 10100), compiled by that factory
# against THIS image's exact gentoo-kernel-bin. See:
#   - build/00-gentoo-common.sh  (module binrepo + nvidia ~amd64/dist-kernel)
#   - build/10-build.sh          (atom + .kver kernel-lockstep gate)
#   - HuntedRaven7/gentoo-ing-akmods  (the factory that builds the module)
#
# Do NOT rename this file to 40-nvidia.sh. The old flow — a second manual
# `emerge x11-drivers/nvidia-drivers` plus `kernel-open` on the kernel atom —
# is superseded: it would diverge from the module binpkg's USE flags
# (--binpkg-respect-use=y would reject it) and, on a sealed --usepkgonly image,
# fails the build. The kernel module from the module overlay is the one and
# only supported path.
#
# This file exists purely as a pointer; it performs no install. If you later
# need per-machine runtime tuning, add a modprobe.d drop-in instead:
#   echo 'options nvidia NVreg_DynamicPowerManagement=0x02' \
#     > /etc/modprobe.d/nvidia-options.conf
###############################################################################

# Placeholder so the script can never accidentally run as a build step.
echo "INFO: nvidia-drivers is provided by 10-build.sh via the gentoo-ing-akmods module overlay; nothing to do here."