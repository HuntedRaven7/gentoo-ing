#!/usr/bin/env bash

set -euo pipefail

###############################################################################
# Example: Installing NVIDIA drivers
###############################################################################
# This is an EXAMPLE file showing the Gentoo way to add NVIDIA support.
# `x11-drivers/nvidia-drivers` ships the kernel module and userspace libraries.
# The binary module (`kernel-open` USE) is preferred because it is prebuilt for
# the gentoo-kernel-bin series that 10-build.sh installs.
#
# To use this script:
# 1. Rename: 40-nvidia.sh
# 2. Add an explicit RUN block for /ctx/build/40-nvidia.sh after 10-build.sh.
#
# NOTE: emerge of nvidia-drivers postinst may require the exact linux-headers
# for the kernel added by 10-build.sh. Keep the kernel + nvidia versions in
# lockstep; seed updated driver binpkgs into gentoo-ing-packages to avoid a
# source build.
###############################################################################

echo 'sys-kernel/gentoo-kernel-bin kernel-open' > /etc/portage/package.use/nvidia
echo 'x11-drivers/nvidia-drivers ~amd64' > /etc/portage/package.accept_keywords/nvidia

emerge --verbose x11-drivers/nvidia-drivers

# Blacklist the open nouveau driver, load the proprietary module at boot
echo 'blacklist nouveau' > /usr/lib/modprobe.d/nvidia-blacklist.conf
echo 'options nvidia NVreg_DynamicPowerManagement=0x02' > /usr/lib/modprobe.d/nvidia-options.conf

echo "NVIDIA driver installed successfully"